# Public Supabase values are safe for the browser; never commit service-role keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# AI providers. Set only the provider(s) enabled in the environment.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Local development-only experimental provider. Never use it with sensitive or production data.
TOKENFAUCET_API_KEY=
TOKENFAUCET_BASE_URL=https://freetokenfaucet.com/v1
TOKENFAUCET_MODEL=deepseek-v4-flash
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OCR policy: native-pdf | tesseract | cloud-fallback
OCR_DEFAULT_MODE=tesseract
OCR_CLOUD_FALLBACK_ENABLED=false

SENTRY_DSN=
APP_ENV=development
